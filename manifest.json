{
  "manifest_version": 3,
  "name": "Neon Currency Converter",
  "description": "Convert selected prices to Neon main currencies using the latest Mastercard exchange rates.",
  "version": "0.3.0",
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "32": "src/assets/icons/icon-32.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.mastercard.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Neon Currency",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "32": "src/assets/icons/icon-32.png"
    }
  },
  "options_page": "src/options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "src/converter/converter.html",
        "src/converter/converter.js",
        "src/converter/converter.css"
      ],
      "matches": [
        "*://*/*",
        "chrome://*/*"
      ]
    },
    {
      "resources": [
        "src/assets/flags/*.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/priceParser.js",
        "src/content/priceHover.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
